rules_version = '2';

// Seules vous deux pouvez lire et modifier les données de l'application.
// Remplacez les deux adresses ci-dessous par vos e-mails (en minuscules),
// les mêmes que celles des comptes créés dans Firebase > Authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email.lower() in [
          'email.de.margaux@exemple.com',
          'email.de.charlotte@exemple.com'
        ];
    }
  }
}
